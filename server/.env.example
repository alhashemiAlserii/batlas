PORT=3000
STUDIO_NAME=Batlas
# Shared secret game servers send as X-Game-Server-Key to /api/game/verify
GAME_SERVER_KEY=change-me-long-random
# Production (HTTPS): NODE_ENV=production enables Secure/__Host- cookies and HSTS
# NODE_ENV=production
# COOKIE_SECURE=true
# TRUST_PROXY=true      # when behind a reverse proxy / load balancer
# DB_FILE=./data/studio.sqlite
# UPLOAD_DIR=./uploads
# Postgres (production / Render). When unset, the SQLite DB_FILE is used.
# DATABASE_URL=postgres://user:pass@host:5432/batlas
# DATABASE_SSL=true      # force TLS on/off (default: on for non-internal hosts)
# SESSION_SECRET=long-random   # cookie-signing secret (Render generates it)
# One-time first Developer on an empty production DB (ignored once a Developer exists):
# BOOTSTRAP_DEVELOPER_PASSWORD=
# BOOTSTRAP_DEVELOPER_USERNAME=abood
# PUBLIC_URL=https://batlas.onrender.com
