{
  "name": "studio-server",
  "version": "1.0.0",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "create-developer": "tsx --env-file-if-exists=.env src/cli/create-developer.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "tsx --env-file-if-exists=.env src/cli/backup.ts",
    "restore": "tsx --env-file-if-exists=.env src/cli/restore.ts",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://batlas:localtest@127.0.0.1:5433/batlas_test} vitest run"
  },
  "type": "module",
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cannon-es": "^0.20.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "stream-json": "^3.9.0",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
